{
  "name": "due",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/claim-port.mjs 8081 && node scripts/secrets.mjs -- npx expo start --port 8081",
    "secrets": "node scripts/secrets.mjs",
    "ios": "node scripts/secrets.mjs -- npx expo run:ios",
    "ios:release": "node scripts/secrets.mjs -- npx expo run:ios --configuration Release",
    "eas": "node scripts/secrets.mjs -- npx eas-cli",
    "typecheck": "tsc --noEmit",
    "check": "node checks/layers.mjs && node checks/orphans.mjs && node checks/facts.mjs && node checks/apiContracts.mjs && tsc --noEmit",
    "sweep": "node checks/sweep.mjs",
    "test": "jest --selectProjects node",
    "test:app": "jest --selectProjects app --runInBand --forceExit",
    "test:all": "jest --runInBand --forceExit",
    "test:ci": "jest --runInBand --forceExit --coverage",
    "build:api": "esbuild src/server/cloudRun.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/cloud-run/server.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@rnmapbox/maps": "^10.3.1",
    "@sentry/node": "^10.63.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~56.0.8",
    "expo-blur": "~56.0.3",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.16",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image-picker": "~56.0.16",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-location": "~56.0.15",
    "expo-maps": "~56.0.6",
    "expo-notifications": "~56.0.21",
    "expo-router": "~56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-share-intent": "7.0.0",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-updates": "~56.0.22",
    "expo-web-browser": "~56.0.5",
    "jose": "^6.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "victory-native": "^41.24.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "~19.2.14",
    "esbuild": "^0.28.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.4",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
